# ─── AI Provider API Keys ─────────────────────────────────────────────────────
# Fill in your actual API keys below.
# You need at least ONE key to test real video generation locally.
OPENAI_API_KEY=
RUNWAY_API_KEY=
PIKA_API_KEY=
LUMA_API_KEY=
GOOGLE_VEO_API_KEY=

# ─── Storage Configuration ───────────────────────────────────────────────────
# local = save files to ./uploads folder (development only)
# s3    = AWS S3 (production)
# r2    = Cloudflare R2 (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# ─── Internal Service URLs ────────────────────────────────────────────────────
ROUTING_ENGINE_URL=http://localhost:3003
ASSET_SERVICE_URL=http://localhost:3006
VIDEO_SERVICE_URL=http://localhost:3011

# ─── Web Studio Public URLs ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WORKFLOW_API_URL=http://localhost:3002
NEXT_PUBLIC_ROUTING_API_URL=http://localhost:3003
NEXT_PUBLIC_TEMPLATE_API_URL=http://localhost:3004
NEXT_PUBLIC_NODE_API_URL=http://localhost:3005
NEXT_PUBLIC_ASSET_API_URL=http://localhost:3006
NEXT_PUBLIC_EXECUTION_API_URL=http://localhost:3007
NEXT_PUBLIC_AUTH_API_URL=http://localhost:3008
NEXT_PUBLIC_PROJECT_API_URL=http://localhost:3009
NEXT_PUBLIC_METRICS_API_URL=http://localhost:3010
NEXT_PUBLIC_VIDEO_API_URL=http://localhost:3011

# ─── App Config ──────────────────────────────────────────────────────────────
NODE_ENV=development
