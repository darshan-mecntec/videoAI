# ─── AI Provider API Keys (required for video generation) ────────────────────
# You need at least ONE key to test real video generation locally.
# Runway and Pika are the most reliable for image-to-video.
OPENAI_API_KEY=
RUNWAY_API_KEY=
PIKA_API_KEY=
LUMA_API_KEY=
GOOGLE_VEO_API_KEY=

# ─── Storage Configuration ───────────────────────────────────────────────────
# local = save generated videos to ./uploads folder (development)
# s3    = AWS S3 (production)
# r2    = Cloudflare R2 (production)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BUCKET_URL=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# ─── Service Ports ───────────────────────────────────────────────────────────
PORT=3011

# ─── Internal Service URLs (used for inter-service communication) ─────────────
ROUTING_ENGINE_URL=http://localhost:3003
ASSET_SERVICE_URL=http://localhost:3006

# ─── App Config ──────────────────────────────────────────────────────────────
NODE_ENV=development
