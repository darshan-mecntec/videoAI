# Provider Registry Service Configuration

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/provider_registry

# Redis Configuration
REDIS_URL=redis://localhost:6379

# NATS Event Bus Configuration
NATS_URL=nats://localhost:4222
NATS_SUBJECT_PREFIX=provider

# Service Configuration
# Set to 'true' to use PostgreSQL, Redis, and NATS instead of in-memory implementations
# Set to 'false' or leave unset for development/testing with in-memory storage
USE_PRODUCTION_SERVICES=false

# Development API Keys (Optional - for testing without secrets manager)
# These can be used for development when you don't have a secrets manager set up
OPENAI_API_KEY=sk-your-openai-key-here
STABILITY_API_KEY=sk-your-stability-key-here
